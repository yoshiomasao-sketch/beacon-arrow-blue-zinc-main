{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "ポートフォリオΔ",
    "version":  "0.1.0",
    "identifier":  "com.portfoliodelta.app",
    "build":  {
                  "frontendDist":  "../dist-tauri",
                  "devUrl":  "http://127.0.0.1:1420",
                  "beforeDevCommand":  "npm run tauri:dev:frontend",
                  "beforeBuildCommand":  "npm run tauri:build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "ポートフォリオΔ",
                                    "width":  1440,
                                    "height":  900,
                                    "resizable":  true,
                                    "fullscreen": false,
                                    "dragDropEnabled": false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               }
               }
}